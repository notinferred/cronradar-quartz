<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>CronRadar.Quartz4</AssemblyName>
    <RootNamespace>CronRadar.Quartz</RootNamespace>
    <DefineConstants>$(DefineConstants);QUARTZ4</DefineConstants>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>

    <!-- Package Information -->
    <PackageId>CronRadar.Quartz4</PackageId>
    <Version>0.1.0</Version>
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    <FileVersion>0.1.0.0</FileVersion>
    <Authors>CronRadar</Authors>
    <Company>CronRadar</Company>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <Product>CronRadar Quartz.NET 4 Extension</Product>
    <Description>Detect late, failed, and stuck Quartz.NET 4 jobs with trigger discovery, schedule translation, and execution monitoring. For Quartz.NET 3, use CronRadar.Quartz.</Description>
    <Copyright>Copyright © CronRadar 2026</Copyright>
    <PackageProjectUrl>https://cronradar.com/quartz</PackageProjectUrl>
    <RepositoryUrl>https://github.com/cronradar/cronradar-quartz</RepositoryUrl>
    <PackageTags>cronradar;quartz;quartz.net;scheduled-jobs;monitoring;missed-jobs;failed-jobs;stuck-jobs;alerts</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <PackageReleaseNotes>First release for Quartz.NET 4.</PackageReleaseNotes>
    <RepositoryType>git</RepositoryType>

    <!-- Build Configuration -->
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\CronRadar.Quartz\*.cs" />
    <ProjectReference Include="..\..\..\cronradar-dotnet\src\CronRadar\CronRadar.csproj" />
    <PackageReference Include="Quartz" Version="4.7.2" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\LICENSE" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
