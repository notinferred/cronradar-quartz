<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net6.0;net7.0;net8.0;net9.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>

    <!-- Package Information -->
    <PackageId>CronRadar.Quartz</PackageId>
    <Version>0.1.1</Version>
    <AssemblyVersion>0.1.1.0</AssemblyVersion>
    <FileVersion>0.1.1.0</FileVersion>
    <Authors>CronRadar</Authors>
    <Company>CronRadar</Company>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <Product>CronRadar Quartz.NET Extension</Product>
    <Description>Detect late, failed, and stuck Quartz.NET jobs with trigger discovery, schedule translation, and execution lifecycle tracking.</Description>
    <Copyright>Copyright © CronRadar 2026</Copyright>
    <PackageProjectUrl>https://cronradar.com/quartz</PackageProjectUrl>
    <RepositoryUrl>https://github.com/cronradar/cronradar-quartz</RepositoryUrl>
    <PackageTags>cronradar;quartz;quartz.net;scheduled-jobs;monitoring;missed-jobs;failed-jobs;stuck-jobs;alerts</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <PackageReleaseNotes>Clarifies scheduled-job reliability coverage and package discovery metadata; runtime behavior is unchanged.</PackageReleaseNotes>
    <RepositoryType>git</RepositoryType>

    <!-- Build Configuration -->
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\cronradar-dotnet\src\CronRadar\CronRadar.csproj" />
    <!-- 3.13.0 is the first Quartz whose dependency tree has no known vulnerabilities: 3.0.x pulls
         System.Data.SqlClient (GHSA-98g6-xh36-x2p7), 3.1.x Microsoft.Data.SqlClient 2.0.0, and through
         3.12 System.Configuration.ConfigurationManager reaches System.Drawing.Common 4.7.0 (GHSA-rxg9-xrhp-64gj) -->
    <PackageReference Include="Quartz" Version="3.13.0" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\LICENSE" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
